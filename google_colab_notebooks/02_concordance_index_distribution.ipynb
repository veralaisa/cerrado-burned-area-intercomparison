
# =============================================================================
# CONCORDANCE INDEX DISTRIBUTION
# =============================================================================

# -----------------------------------------------------------------------------
# PREPARE DATA
# -----------------------------------------------------------------------------

df_box = gdf_concordancia[
    [
        'id_int',
        'Indice_Concordancia',
        'Indice_Concordancia_MCD64A1_GABAM',
        'Indice_Concordancia_MCD64A1_MapBiomas',
        'Indice_Concordancia_GABAM_MapBiomas'
    ]
]

# Convert from wide to long format
df_boxplot = df_box.melt(
    id_vars='id_int',
    var_name='dataset_combination',
    value_name='concordance_index'
)

# Remove zero values
df_boxplot = df_boxplot[
    df_boxplot['concordance_index'] > 0
]

# Rename labels
df_boxplot['dataset_combination'] = (
    df_boxplot['dataset_combination']
    .map(label_map_en)
)

# -----------------------------------------------------------------------------
# CREATE BOXPLOT
# -----------------------------------------------------------------------------

plt.figure(figsize=(11, 6))

ax = sns.boxplot(
    data=df_boxplot,
    x='dataset_combination',
    y='concordance_index',
    hue='dataset_combination',
    palette=custom_palette,
    width=0.6,
    showfliers=False
)

# -----------------------------------------------------------------------------
# COMPUTE SUMMARY STATISTICS
# -----------------------------------------------------------------------------

stats = (
    df_boxplot
    .dropna(subset=['concordance_index'])
    .groupby('dataset_combination')[
        'concordance_index'
    ]
    .agg(
        median='median',
        std='std',
        q3=lambda x: x.quantile(0.75)
    )
    .reset_index()
)

# Match annotation order with x-axis labels
x_order = [
    tick.get_text()
    for tick in ax.get_xticklabels()
]

stats['x_position'] = (
    stats['dataset_combination']
    .apply(
        lambda value:
        x_order.index(value)
        if value in x_order
        else np.nan
    )
)

stats = (
    stats
    .dropna(subset=['x_position'])
    .sort_values('x_position')
)

# -----------------------------------------------------------------------------
# ADD STATISTICAL ANNOTATIONS
# -----------------------------------------------------------------------------

ymin, ymax = ax.get_ylim()

for _, row in stats.iterrows():

    annotation = (
        f"Median = {row['median']:.2f}\n"
        f"SD = {row['std']:.2f}"
    )

    ax.text(
        row['x_position'],
        row['q3'] + 0.03,
        annotation,
        ha='center',
        va='bottom',
        fontsize=9
    )

# -----------------------------------------------------------------------------
# FIGURE STYLE
# -----------------------------------------------------------------------------

ax.set_xlabel(
    'Dataset Combination',
    fontsize=12
)

ax.set_ylabel(
    'Concordance Index',
    fontsize=12
)

ax.set_title(
    'Concordance Index Distribution',
    fontsize=14,
    weight='bold'
)

ax.legend_.remove()

plt.xticks(rotation=10)

plt.tight_layout()

# -----------------------------------------------------------------------------
# EXPORT FIGURE
# -----------------------------------------------------------------------------

output_path = (
    f'{FIGURES_DIR}/'
    'concordance_index_distribution.png'
)

plt.savefig(
    output_path,
    dpi=300,
    bbox_inches='tight'
)

plt.show()

print(f'Figure exported to:\n{output_path}')
